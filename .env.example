MONGODB_URI=mongodb://mongo:27017
MONGODB_DATABASE=kust
KUST_ENCRYPTION_KEY=replace-with-at-least-24-random-characters
LISTEN_ADDR=0.0.0.0:8080
CORS_ORIGIN=http://localhost:5173
# Optional read-only kubeconfig preset file or directory. The local default is
# ../../tj_config resolved from the backend crate directory.
# KUST_PRESET_CONFIG_PATH=/absolute/path/to/tj_config
# KUST_PRESET_CONFIG_DIR=/absolute/path/to/presets
# Optional OA integration notes/config file. Explicit environment variables win.
# OA_CONFIG_PATH=/absolute/path/to/oa_auth.txt
# Required for new user registration: GET this endpoint with ?itcode=<username>.
# OA_USER_INFO_URL=https://oa.example/user-info
# SPRINGBOARD_URL=https://oa.example/springboard_v3
# SPRINGBOARD_APP=kust
