MONGODB_URI=mongodb://mongo:27017
MONGODB_DATABASE=kust
KUST_ENCRYPTION_KEY=replace-with-at-least-24-random-characters
LISTEN_ADDR=0.0.0.0:8080
CORS_ORIGIN=http://localhost:5173
# Optional read-only kubeconfig preset file or directory. The local default is
# ../../tj_config resolved from the backend crate directory.
# KUST_PRESET_CONFIG_PATH=/absolute/path/to/tj_config
# KUST_PRESET_CONFIG_DIR=/absolute/path/to/presets
# Optional OA integration notes/config file. Explicit environment variables win.
# OA_CONFIG_PATH=/absolute/path/to/oa_auth.txt
# Required for new user registration: GET this endpoint with ?itcode=<username>.
# OA_USER_INFO_URL=https://oa.example/user-info
# SPRINGBOARD_URL=https://oa.example/springboard_v3
# SPRINGBOARD_APP=kust
# Application hosting (disabled unless all deployment controls are configured).
# KUST_APP_HOSTING_ENABLED=true
# KUST_JENKINS_URL=http://jenkins.internal
# KUST_JENKINS_USER=kust-automation
# KUST_JENKINS_API_TOKEN=secret
# KUST_JENKINS_APP_JOB=kust_customer_apps/application-hosting
# Optional internal Kust URL reachable from Jenkins; falls back to FRONT_URL.
# KUST_APP_CALLBACK_BASE_URL=http://kust-api.custom-apps.svc.cluster.local:8080
# KUST_APP_IMAGE_PULL_SECRET=kust-harbor
# KUST_APP_ALLOWED_NAMESPACES=custom-apps,team-preview
# KUST_APP_ALLOWED_GIT_HOSTS=gitlab.1oa.com.cn,github.com,gitlab.com
# KUST_APP_ROLLOUT_TIMEOUT_SECONDS=900
# KUST_APP_DEFAULT_GATEWAY_NAME=k8s-gateway
# KUST_APP_DEFAULT_GATEWAY_NAMESPACE=traefik-system
# KUST_APP_DEFAULT_ROUTE_HOST=apps.example.internal
# KUST_APP_ROUTE_PREFIX=/apps
# KUST_APP_HARBOR_REPOSITORY_PREFIX=harbor.example.internal/kust-apps
# Platform-maintained non-root proxy image used for every hosted application.
# KUST_APP_PROXY_IMAGE=harbor.example.internal/kust/kust_app_proxy@sha256:...
# Gateway URL reachable from the API Pod. Kust verifies this after every rollout.
# KUST_APP_PUBLIC_VERIFY_URL=http://traefik.traefik-system.svc.cluster.local
