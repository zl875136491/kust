worker_processes auto;
pid /tmp/kust-proxy.pid;
error_log /dev/stderr notice;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    # Pods share one network namespace. Use a platform-reserved high port so
    # the proxy never collides with an application using the common 8080.
    listen 18080;
    server_name _;
    # Keep rewritten Location headers relative. Otherwise nginx serializes them
    # with this sidecar's internal listener port and sends clients to :18080.
    absolute_redirect off;

    location = /_kust_proxy/healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        rewrite ^${KUST_APP_ROUTE_PATH}/?(.*)$ /$1 break;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix ${KUST_APP_ROUTE_PATH};
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;

        # Rewriting needs an uncompressed upstream response. It covers standard
        # absolute asset/API URLs without accepting user-provided proxy config.
        proxy_set_header Accept-Encoding "";
        sub_filter_once off;
        # Rewrite only URL-bearing markup attributes and CSS URLs. Generic
        # quote-prefix replacement also touches inline scripts, which corrupts
        # applications such as code-server. The HTML bridge below handles
        # runtime fetch and WebSocket requests.
        sub_filter_types text/html text/css application/json application/javascript text/javascript;
        sub_filter 'href="/' 'href="${KUST_APP_ROUTE_PATH}/';
        sub_filter 'src="/' 'src="${KUST_APP_ROUTE_PATH}/';
        sub_filter 'action="/' 'action="${KUST_APP_ROUTE_PATH}/';
        sub_filter 'url(/' 'url(${KUST_APP_ROUTE_PATH}/';
        # SvelteKit applications keep their runtime base in an inline boot
        # script. Without rewriting it, dynamic imports resolve at the host
        # root (/_app/...) and bypass the managed application path.
        sub_filter 'base: ""' 'base: "${KUST_APP_ROUTE_PATH}"';
        # SvelteKit's boot script imports entry modules with absolute URLs;
        # rewrite those imports as well as the preload links above.
        sub_filter 'import("/' 'import("${KUST_APP_ROUTE_PATH}/';
        # Open WebUI redirects anonymous users with window.location.href="/".
        # Under a managed subpath that would leave the application and reach
        # Kust's own auth page, so preserve the application root explicitly.
        sub_filter 'window.location.href="/"' 'window.location.href="${KUST_APP_ROUTE_PATH}/"';

        # Keep runtime-generated root-relative API, asset, and WebSocket URLs
        # inside the managed application route.
        sub_filter '<head>' '<head><script>(function(){var p="${KUST_APP_ROUTE_PATH}",s=String.fromCharCode(47),f=window.fetch;function q(i){var u=typeof i==="string"?i:i&&i.url;if(typeof u==="string"&&u.charAt(0)===s&&u.indexOf(p+s)!==0){var v=p+u;return typeof i==="string"?v:new Request(v,i)}}function n(i){if(typeof i!=="string"||i.charAt(0)!==s||i.indexOf(p+s)===0||i===p)return i;return p+i}window.fetch=function(i,n){return f.call(this,q(i)||i,n)};var w=window.WebSocket;if(w){var C=function(u,n){if(typeof u==="string"){var x=new URL(u,window.location.href);if(x.pathname.charAt(0)===s&&x.pathname.indexOf(p+s)!==0){x.pathname=p+x.pathname;u=x.href}}return n===void 0?new w(u):new w(u,n)};C.prototype=w.prototype;window.WebSocket=C}var l=window.Location&&Location.prototype;if(l){var h=Object.getOwnPropertyDescriptor(l,"href");if(h&&h.set&&h.get)try{Object.defineProperty(l,"href",{configurable:h.configurable,enumerable:h.enumerable,get:h.get,set:function(i){return h.set.call(this,n(i))}})}catch(i){}["assign","replace"].forEach(function(i){var o=l[i];if(typeof o==="function")try{l[i]=function(u){return o.call(this,n(u))}}catch(u){}})}["pushState","replaceState"].forEach(function(i){var o=history[i];if(typeof o==="function")history[i]=function(u,x,v){return o.call(this,u,x,n(v))}});document.addEventListener("click",function(i){var o=i.target&&i.target.closest&&i.target.closest("a[href]");if(o){var u=o.getAttribute("href");if(u)o.setAttribute("href",n(u))}},true)})();</script>';

        # code-server emits Location: ./?folder=...; preserve the app prefix.
        proxy_redirect ~^\./(.*)$ ${KUST_APP_ROUTE_PATH}/$1;
        proxy_redirect ~^/(.*)$ ${KUST_APP_ROUTE_PATH}/$1;
        # Some applications construct an absolute redirect from their internal
        # listener (for example http://host:8080/). Never expose that internal
        # address or drop the managed application prefix.
        proxy_redirect ~^https?://[^/]+/(.*)$ ${KUST_APP_ROUTE_PATH}/$1;
        proxy_cookie_path / ${KUST_APP_ROUTE_PATH}/;

        proxy_pass ${KUST_APP_UPSTREAM_SCHEME}://127.0.0.1:${KUST_APP_UPSTREAM_PORT};
    }
}
}
