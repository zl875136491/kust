pipeline {
  // User repositories are untrusted build input. Keep this label on an isolated Docker-capable agent.
  agent { label "docker" }
  options {
    skipDefaultCheckout(true)
    timeout(time: 45, unit: "MINUTES")
    buildDiscarder(logRotator(numToKeepStr: "40", artifactNumToKeepStr: "40"))
    timestamps()
  }
  parameters {
    string(name: "APPLICATION_ID", trim: true)
    string(name: "BUILD_ID", trim: true)
    string(name: "REPOSITORY_URL", trim: true)
    string(name: "GIT_REF", trim: true)
    choice(name: "BUILD_MODE", choices: ["dockerfile", "buildpack", "static", "custom"])
    string(name: "IMAGE_REPOSITORY", trim: true)
    string(name: "KUST_CALLBACK_URL", trim: true)
    string(name: "KUST_CALLBACK_RESOLVE", defaultValue: "", trim: true)
    password(name: "KUST_SOURCE_TOKEN", defaultValue: "", description: "One-time Kust source lease")
    password(name: "KUST_CALLBACK_TOKEN", defaultValue: "", description: "Per-build Kust callback token")
  }
  environment {
    HARBOR_REGISTRY = "10.17.158.118"
    BUILDKIT_NO_CLIENT_TOKEN = "true"
    HTTP_PROXY = "http://10.32.129.253:10811"
    HTTPS_PROXY = "http://10.32.129.253:10811"
    NO_PROXY = "localhost,127.0.0.1,::1,10.17.158.69,10.17.158.71,10.17.158.118,10.17.158.156,k8s.1oa.com.cn"
  }
  stages {
    stage("Validate") {
      steps {
        script {
          if (!params.BUILD_ID || !params.APPLICATION_ID || !params.REPOSITORY_URL || !params.IMAGE_REPOSITORY || !params.KUST_CALLBACK_URL) {
            error("Hosting build parameters are incomplete.")
          }
          if (!params.IMAGE_REPOSITORY.startsWith("${env.HARBOR_REGISTRY}/")) {
            error("IMAGE_REPOSITORY must use the approved Harbor registry.")
          }
        }
      }
    }
    stage("Load source lease") {
      steps {
        sh '''#!/usr/bin/env bash
set -Eeuo pipefail
set +x
test -n "${KUST_SOURCE_TOKEN}"
resolve_args=()
callback_resolve="${KUST_CALLBACK_RESOLVE:-k8s.1oa.com.cn:80:10.17.158.71}"
if [ -n "${callback_resolve}" ]; then
  resolve_args=(--resolve "${callback_resolve}")
fi
curl --fail --silent --show-error "${resolve_args[@]}" --header "X-Kust-Build-Token: ${KUST_SOURCE_TOKEN}" "${KUST_CALLBACK_URL%/callback}/source" > source.json
test -s source.json
'''
      }
    }
    stage("Checkout") {
      steps {
        sh '''#!/usr/bin/env bash
set -Eeuo pipefail
set +x
repo="$(jq -r '.repositoryUrl' source.json)"
ref="$(jq -r '.gitRef' source.json)"
kind="$(jq -r '.credential.type // empty' source.json)"
username="$(jq -r '.credential.username // "oauth2"' source.json)"
secret="$(jq -r '.credential.secret // empty' source.json)"
rm -rf app
if [ "${kind}" = "ssh_key" ]; then
  key="$(mktemp)"
  trap 'rm -f "${key}"' EXIT
  printf '%s' "${secret}" > "${key}"
  chmod 600 "${key}"
  export GIT_SSH_COMMAND="ssh -o StrictHostKeyChecking=accept-new -i ${key}"
  git clone --no-checkout "${repo}" app
elif [ "${kind}" = "token" ]; then
  askpass="$(mktemp)"
  trap 'rm -f "${askpass}"' EXIT
  cat > "${askpass}" <<'EOF'
#!/bin/sh
printf '%s\n' "${KUST_GIT_SECRET}"
EOF
  chmod 700 "${askpass}"
  export KUST_GIT_SECRET="${secret}"
  export GIT_ASKPASS="${askpass}"
  export GIT_TERMINAL_PROMPT=0
  git clone --no-checkout "https://${username}@${repo#*://}" app
else
  git clone --no-checkout "${repo}" app
fi
cd app
git fetch --depth=1 origin "${ref}"
git checkout --detach FETCH_HEAD
git rev-parse HEAD > ../git-commit.txt
cd ..
unset secret KUST_GIT_SECRET GIT_ASKPASS GIT_TERMINAL_PROMPT GIT_SSH_COMMAND || true
jq '{sourceSubdirectory, buildCommand, outputDirectory, buildEnvironment}' source.json > build-input.json
rm -f source.json
'''
      }
    }
    stage("Build image") {
      steps {
        sh '''#!/usr/bin/env bash
set -Eeuo pipefail
commit="$(cat git-commit.txt)"
image="${IMAGE_REPOSITORY}:sha-${commit:0:12}"
subdir="$(jq -r '.sourceSubdirectory // empty' build-input.json)"
command="$(jq -r '.buildCommand // empty' build-input.json)"
output="$(jq -r '.outputDirectory // empty' build-input.json)"
work=app
[ -z "${subdir}" ] || work="app/${subdir}"
test -d "${work}"
build_args=(
  --build-arg "HTTP_PROXY=${HTTP_PROXY}"
  --build-arg "HTTPS_PROXY=${HTTPS_PROXY}"
  --build-arg "NO_PROXY=${NO_PROXY}"
  --build-arg "GLOBAL_AGENT_HTTP_PROXY=${HTTP_PROXY}"
  --build-arg "GLOBAL_AGENT_HTTPS_PROXY=${HTTPS_PROXY}"
)
while IFS=$'\t' read -r key value; do
  [ -n "${key}" ] || continue
  build_args+=(--build-arg "${key}=${value}")
done < <(jq -r '.buildEnvironment // {} | to_entries[] | "\(.key)\t\(.value)"' build-input.json)

# Docker proxy build args are available only to stages that declare them. Render a
# temporary Dockerfile which declares the controlled build environment after every
# FROM line, without modifying the user repository. This also covers Node tools
# such as global-agent that need GLOBAL_AGENT_HTTPS_PROXY explicitly.
render_dockerfile() {
  local source="$1" target="$2"
  local injected="${target}.env"
  {
    printf '%s\n' 'ARG HTTP_PROXY' 'ARG HTTPS_PROXY' 'ARG NO_PROXY' 'ARG GLOBAL_AGENT_HTTP_PROXY' 'ARG GLOBAL_AGENT_HTTPS_PROXY'
    printf '%s\n' 'ENV HTTP_PROXY=${HTTP_PROXY} HTTPS_PROXY=${HTTPS_PROXY} NO_PROXY=${NO_PROXY} http_proxy=${HTTP_PROXY} https_proxy=${HTTPS_PROXY} no_proxy=${NO_PROXY} GLOBAL_AGENT_HTTP_PROXY=${GLOBAL_AGENT_HTTP_PROXY} GLOBAL_AGENT_HTTPS_PROXY=${GLOBAL_AGENT_HTTPS_PROXY}'
    jq -r '.buildEnvironment // {} | to_entries[] | "ARG \(.key)\nENV \(.key)=${\(.key)}"' build-input.json
  } > "${injected}"
  awk -v injected="${injected}" '
    BEGIN { while ((getline line < injected) > 0) additions = additions line "\n"; close(injected) }
    /^[[:space:]]*FROM[[:space:]]/ { print; printf "%s", additions; next }
    { print }
  ' "${source}" > "${target}"
}
case "${BUILD_MODE}" in
  dockerfile)
    dockerfile="$(mktemp "${WORKSPACE_TMP:-/tmp}/kust-Dockerfile.XXXXXX")"
    render_dockerfile "${work}/Dockerfile" "${dockerfile}"
    trap 'rm -f "${dockerfile}" "${dockerfile}.env"' EXIT
    docker build --pull --provenance=false "${build_args[@]}" --file "${dockerfile}" --tag "${image}" "${work}"
    ;;
  buildpack) pack build "${image}" --path "${work}" --builder paketobuildpacks/builder-jammy-base ;;
  static|custom)
    [ -n "${command}" ] || command="npm ci && npm run build"
    docker run --rm -e HTTP_PROXY -e HTTPS_PROXY -e NO_PROXY -v "${PWD}/${work}:/workspace" -w /workspace node:22-bookworm bash -lc "${command}"
    [ -n "${output}" ] || output=dist
    test -d "${work}/${output}"
    temp="$(mktemp -d)"
    trap 'rm -rf "${temp}"' EXIT
    cp -a "${work}/${output}/." "${temp}/"
    cat > "${temp}/default.conf" <<'EOF'
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  location / { try_files $uri $uri/ /index.html; }
}
EOF
    # The platform Deployment enforces runAsNonRoot. Use the upstream unprivileged
    # Nginx image so every static application is compatible by construction.
    printf 'FROM nginxinc/nginx-unprivileged:1.27-alpine\nCOPY default.conf /etc/nginx/conf.d/default.conf\nCOPY --chown=101:101 . /usr/share/nginx/html\nEXPOSE 8080\n' > "${temp}/Dockerfile"
    docker build --pull --provenance=false --build-arg HTTP_PROXY --build-arg HTTPS_PROXY --build-arg NO_PROXY --tag "${image}" "${temp}"
    ;;
  *) exit 2 ;;
esac
printf '%s' "${image}" > image-ref.txt
'''
      }
    }
    stage("Push and callback") {
      steps {
        withCredentials([
          usernamePassword(credentialsId: "infra_harbor_auth", usernameVariable: "HARBOR_USERNAME", passwordVariable: "HARBOR_PASSWORD")
        ]) {
          sh '''#!/usr/bin/env bash
set -Eeuo pipefail
set +x
image="$(cat image-ref.txt)"
commit="$(cat git-commit.txt)"
config="$(mktemp -d)"
trap 'docker logout "${HARBOR_REGISTRY}" >/dev/null 2>&1 || true; rm -rf "${config}"' EXIT
export DOCKER_CONFIG="${config}"
printf '%s' "${HARBOR_PASSWORD}" | docker login "${HARBOR_REGISTRY}" --username "${HARBOR_USERNAME}" --password-stdin >/dev/null
docker push "${image}" | tee push.log
digest="$(awk '/digest: sha256:/{for (i = 1; i <= NF; i++) if ($i ~ /^sha256:/) {print $i; exit}}' push.log)"
test -n "${digest}"
digest_ref="${IMAGE_REPOSITORY}@${digest}"
payload="$(jq -n --arg status succeeded --arg commit "${commit}" --arg image "${image}" --arg digest "${digest_ref}" --arg url "${BUILD_URL}" '{status:$status,gitCommit:$commit,imageRef:$image,imageDigestRef:$digest,jenkinsBuildUrl:$url,message:"Image pushed; Kust is applying controlled Kubernetes resources"}')"
resolve_args=()
callback_resolve="${KUST_CALLBACK_RESOLVE:-k8s.1oa.com.cn:80:10.17.158.71}"
if [ -n "${callback_resolve}" ]; then
  resolve_args=(--resolve "${callback_resolve}")
fi
curl --fail --silent --show-error "${resolve_args[@]}" --header "X-Kust-Build-Token: ${KUST_CALLBACK_TOKEN}" --header "Content-Type: application/json" --data "${payload}" "${KUST_CALLBACK_URL}"
'''
        }
      }
    }
  }
  post {
    failure {
      sh '''#!/usr/bin/env bash
set +e
if [ -z "${KUST_CALLBACK_URL:-}" ] || [ -z "${KUST_CALLBACK_TOKEN:-}" ]; then
  exit 0
fi
payload="$(jq -n --arg status failed --arg message "Jenkins build failed: ${BUILD_URL}" --arg url "${BUILD_URL}" '{status:$status,message:$message,jenkinsBuildUrl:$url}')"
resolve_args=()
callback_resolve="${KUST_CALLBACK_RESOLVE:-k8s.1oa.com.cn:80:10.17.158.71}"
if [ -n "${callback_resolve}" ]; then
  resolve_args=(--resolve "${callback_resolve}")
fi
curl --silent --show-error "${resolve_args[@]}" --header "X-Kust-Build-Token: ${KUST_CALLBACK_TOKEN}" --header "Content-Type: application/json" --data "${payload}" "${KUST_CALLBACK_URL}" || true
'''
    }
    always { sh "rm -rf app source.json build-input.json git-commit.txt image-ref.txt push.log || true" }
  }
}
